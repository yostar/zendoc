{
  "name": "yms-zendoc",
  "displayName": "Zendoc for Cursor",
  "description": "Distraction-free writing, powered by AI. Turns Cursor into a writing platform with auto-backup to GitHub.",
  "version": "0.1.21",
  "publisher": "YMSDynamics",
  "repository": {
    "type": "git",
    "url": "https://github.com/yostar/zendoc"
  },
  "bugs": {
    "url": "https://github.com/yostar/zendoc/issues"
  },
  "homepage": "https://zendoc.org",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zendoc.createWorkspace",
        "title": "Create Zendoc workspace"
      },
      {
        "command": "zendoc.showWelcome",
        "title": "Show Zendoc welcome"
      },
      {
        "command": "zendoc.setupBackup",
        "title": "Set up cloud backup (GitHub)"
      }
    ],
    "keybindings": [
      {
        "command": "zendoc.createWorkspace",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "icon": "icon.png",
  "license": "MIT",
  "keywords": [
    "writing",
    "markdown",
    "cursor",
    "github",
    "distraction-free",
    "ai"
  ],
  "galleryBanner": {
    "color": "#faf8f5",
    "theme": "light"
  }
}